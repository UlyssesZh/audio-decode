{
  "name": "@audio/decode-webm",
  "version": "1.4.1",
  "description": "Decode WebM audio (Opus, Vorbis) to PCM samples",
  "type": "module",
  "main": "decode-webm.js",
  "types": "decode-webm.d.ts",
  "exports": {
    ".": "./decode-webm.js",
    "./audio": {
      "types": "./audio.d.ts",
      "default": "./audio.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "decode-webm.js",
    "decode-webm.d.ts",
    "src/opus.wasm.js",
    "LICENSE",
    "LICENSE.libopus",
    "audio.js",
    "audio.d.ts"
  ],
  "dependencies": {
    "@audio/decode-opus": "^1.3.0",
    "@audio/decode-vorbis": "^1.3.0"
  },
  "keywords": [
    "webm",
    "matroska",
    "ebml",
    "opus",
    "vorbis",
    "audio",
    "decode",
    "decoder",
    "pcm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "audiojs",
  "homepage": "https://github.com/audiojs/decode/tree/master/packages/decode-webm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/decode.git",
    "directory": "packages/decode-webm"
  },
  "engines": {
    "node": ">=18"
  },
  "bugs": "https://github.com/audiojs/decode/issues",
  "scripts": {
    "build": "bash build.sh",
    "prepack": "npm run build",
    "test": "node test.js"
  },
  "audio": "./audio.js",
  "sideEffects": false,
  "funding": "https://github.com/sponsors/audiojs"
}
