    "libgsm",
    "speech"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "audiojs",
  "homepage": "https://github.com/audiojs/decode/tree/main/packages/decode-gsm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/decode.git",
    "directory": "packages/decode-gsm"
  },
  "bugs": "https://github.com/audiojs/decode/issues",
  "engines": {
    "node": ">=18"
  },
  "audio": "./audio.js",
  "sideEffects": false,
  "funding": "https://github.com/sponsors/audiojs"
