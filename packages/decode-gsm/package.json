{
  "name": "@audio/decode-gsm",
  "version": "0.1.0",
  "description": "Decode GSM 06.10 full rate audio (libgsm WASM)",
  "type": "module",
  "main": "decode-gsm.js",
  "types": "decode-gsm.d.ts",
  "exports": {
    ".": "./decode-gsm.js",
