{
  "name": "@audio/decode-wma",
  "version": "1.4.0",
  "description": "Decode WMA audio (v1, v2, Pro, Lossless) with FFmpeg's decoders, WASM",
  "type": "module",
  "main": "decode-wma.js",
  "types": "decode-wma.d.ts",
  "exports": {
    ".": "./decode-wma.js",
    "./audio": {
      "types": "./audio.d.ts",
      "default": "./audio.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "decode-wma.js",
    "decode-wma.d.ts",
    "src/wma.wasm.js",
    "LICENSE",
    "LICENSE.ffmpeg",
    "audio.js",
    "audio.d.ts"
  ],
  "scripts": {
    "build": "bash build.sh",
    "prepack": "npm run build",
    "test": "node test.js"
  },
  "keywords": [
    "wma",
    "windows-media-audio",
    "asf",
    "audio",
    "decode",
    "decoder",
    "wasm",
    "ffmpeg"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "LGPL-2.1-or-later",
  "author": "audiojs",
  "homepage": "https://github.com/audiojs/decode/tree/master/packages/decode-wma#readme",
  "bugs": "https://github.com/audiojs/decode/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/decode.git",
    "directory": "packages/decode-wma"
  },
  "engines": {
    "node": ">=18"
  },
  "audio": "./audio.js",
  "sideEffects": false,
  "funding": "https://github.com/sponsors/audiojs"
}
